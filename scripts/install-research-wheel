#!/bin/sh
# Install a local build through Lima's generated OpenSSH configuration.
set -eu
if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    echo 'usage: install-research-wheel path/to/berman-VERSION-py3-none-any.whl' >&2
    exit 2
fi
wheel_name=$(basename "$1")
case "$wheel_name" in
    *[!a-zA-Z0-9._+-]*) exit 2 ;;
    berman-*-py3-none-any.whl) ;;
    *) echo 'expected a portable Berman wheel' >&2; exit 2 ;;
esac
digest=$(shasum -a 256 < "$1" | cut -d ' ' -f 1)
ssh_config="${LIMA_HOME:-$HOME/.lima}/berman-research/ssh.config"
ssh -T -F "$ssh_config" lima-berman-research "set -eu
    umask 077
    stage=\$(mktemp -d)
    trap 'rm -rf -- \"\$stage\"' EXIT
    cd \"\$stage\"
    cat > '$wheel_name'
    echo '$digest  $wheel_name' | sha256sum --check --strict
    if [ ! -x ~/.local/berman/bin/python ]; then
        python3.14 -m venv ~/.local/berman
    fi
    ~/.local/berman/bin/python -m pip install --disable-pip-version-check './$wheel_name'
    ~/.local/berman/bin/python -m pip install --no-index --force-reinstall --no-deps './$wheel_name'
    ~/.local/berman/bin/python -m pip check
" < "$1"
