FROM docker.io/library/debian:trixie-slim
RUN export DEBIAN_FRONTEND=noninteractive && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gcc git libc6-dev make perl tracker-miner-fs tracker-extract dbus-daemon dconf-gsettings-backend libglib2.0-bin \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/sh builder
# The suite checks that some directories cannot be listed, which holds only for an unprivileged login.
USER builder
ENV HOME=/home/builder PATH=/home/builder/.cargo/bin:/home/builder/.local/bin:$PATH
WORKDIR /home/builder/berman
COPY --chown=builder rust-toolchain.toml ./
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none && rustup show active-toolchain
COPY --chown=builder . .
# Install as the README describes, then build the suite so that running it needs no network.
RUN cargo install --locked --path . --root "$HOME/.local" \
    && cargo test --locked --no-run && cargo build --locked --example scripted-actor
ENV CARGO_NET_OFFLINE=true
CMD ["sh", "-c", "berman verify && cargo test --locked && GSETTINGS_BACKEND=keyfile dbus-run-session -- development/container/desktop-search"]
