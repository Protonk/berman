{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:run-catalogue-1",
  "title": "berman.run-catalogue/1",
  "description": "Explicit associations for runs that predate connection records, and support collections excluded from research numbering. Structure only: run identities and their uniqueness are checked by berman.config.",
  "type": "object",
  "required": ["schema", "runs"],
  "properties": {
    "schema": {"const": "berman.run-catalogue/1"},
    "support_collections": {"type": "array", "items": {"type": "string"}},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run", "connection"],
        "properties": {
          "run": {"type": "string"},
          "connection": {"type": "string"},
          "relationship": {"type": "string"},
          "basis": {"type": "string"}
        }
      }
    }
  }
}
