{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:recipe-2",
  "title": "berman.recipe/2",
  "description": "Worker instructions for a notes assignment. The instructions file belongs to the recipe directory and contains one {{notes_directory}} placeholder. An empty connections list permits any connection.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "connections",
    "coverage",
    "recording_protocol",
    "instructions"
  ],
  "properties": {
    "schema": {
      "const": "berman.recipe/2"
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      }
    },
    "coverage": {
      "const": [
        "notes"
      ]
    },
    "instructions": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "recording_protocol": {
      "enum": [
        "work-accounts/1",
        "participant-inquiry/1"
      ]
    }
  }
}
