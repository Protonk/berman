{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:recipe-2",
  "title": "berman.recipe/2",
  "description": "Versioned worker guidance for named connections (recipe.json). Structure only: the notes coverage, the supported recording protocols, the connection a recipe is worded for and its files staying within its folder are checked by berman.recipes.",
  "type": "object",
  "required": ["schema", "id", "connections", "coverage", "recording_protocol", "instructions", "research_commission"],
  "properties": {
    "schema": {"const": "berman.recipe/2"},
    "id": {"type": "string"},
    "connections": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "array", "items": {"type": "string"}},
    "recording_protocol": {"type": "string"},
    "instructions": {"type": "string", "minLength": 1},
    "research_commission": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "meaning": {"type": "string"}
  }
}
