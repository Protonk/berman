{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:verification-1",
  "title": "berman.verification/1",
  "description": "Software verification reported by berman --json verify. Each check records its own status and scope.",
  "type": "object",
  "required": ["schema", "scope", "verdict", "checked_at_utc", "root", "code", "checks", "failed", "not_run",
               "not_established", "not_covered", "record", "meaning"],
  "properties": {
    "schema": {"const": "berman.verification/1"},
    "scope": {"enum": ["software"]},
    "verdict": {"enum": ["passed", "failed", "incomplete"]},
    "checked_at_utc": {"type": "string"},
    "root": {"type": "null"},
    "code": {"type": "string"},
    "python": {"type": "string"},
    "python_version": {"type": ["string", "null"]},
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "required", "summary", "details", "meaning"],
        "properties": {
          "status": {"enum": ["passed", "failed", "not-established", "not-run"]},
          "required": {"type": "boolean"},
          "summary": {"type": "string"},
          "next": {"type": "string"},
          "details": {"type": "object"},
          "meaning": {"type": "string"}
        }
      }
    },
    "failed": {"$ref": "#/$defs/names"},
    "not_run": {"$ref": "#/$defs/names"},
    "not_established": {"$ref": "#/$defs/names"},
    "not_covered": {"$ref": "#/$defs/names"},
    "record": {"type": "null"},
    "meaning": {"type": "string"}
  },
  "$defs": {
    "names": {"type": "array", "items": {"type": "string"}}
  }
}
