{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:research-plan-1",
  "title": "berman.research-plan/1",
  "description": "An optional guest research plan naming a connection and an ordered sequence of steps and recipes.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "connection",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "berman.research-plan/1"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "recipe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "recipe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "connection": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    }
  }
}
