{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:workspace-1",
  "title": "berman.workspace/1",
  "description": "A co-located workspace's local installation settings (berman.json), as release 0.26.3 or earlier wrote them; this version reads the file and never writes it. Required and typed here is what loading a workspace reads as a path, iterates or indexes; a wrong value there used to end in a bare key name or a traceback. The reading edition and registered connection names are judged by berman.records in its own words. Harness executables, interpreters, adapters and the fieldwork model are settings of the release that operated the workspace and are not used. Fields Berman only stores are not constrained.",
  "type": "object",
  "required": [
    "schema",
    "packet_root",
    "codex_home",
    "python",
    "codex",
    "connections"
  ],
  "properties": {
    "schema": {
      "const": "berman.workspace/1"
    },
    "packet_root": {
      "type": "string"
    },
    "codex_home": {
      "type": "string"
    },
    "claude_home": {
      "type": "string"
    },
    "python": {
      "type": "string"
    },
    "runtime_python": {
      "type": "string"
    },
    "codex": {
      "type": "string"
    },
    "claude": {
      "type": "string"
    },
    "default_connection": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_connection": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalogue": {
      "description": "A path, or anything false for none.",
      "anyOf": [
        {
          "type": [
            "string",
            "null",
            "boolean"
          ]
        },
        {
          "enum": [
            0,
            [],
            {}
          ]
        }
      ]
    },
    "support_collections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualified_adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/connection"
      }
    },
    "historical_runs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^run-[0-9]{3,6}$"
      }
    }
  },
  "$defs": {
    "connection": {
      "description": "This workspace's binding of a named connection to a checkout.",
      "type": "object",
      "required": [
        "definition",
        "checkout"
      ],
      "properties": {
        "definition": {
          "type": "string"
        },
        "checkout": {
          "type": "string"
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "development": {
          "description": "Historical development wrapper paths; not used.",
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
