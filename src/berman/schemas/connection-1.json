{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:connection-1",
  "title": "berman.connection/1",
  "description": "A named project description (connection.json). Structure only: the identity, the single {head} placeholder, check identities and timeouts, and paths staying within the connection's folder are checked by berman.config and berman.harnesses.",
  "type": "object",
  "required": ["schema", "id", "documents", "commission", "revision"],
  "properties": {
    "schema": {"const": "berman.connection/1"},
    "id": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": ["integer", "string", "null"]},
    "description": {"type": "string"},
    "documents": {"type": "array", "items": {"type": "string"}},
    "commission": {"type": "string", "minLength": 1},
    "revision": {"type": "string"},
    "readers": {"type": "array", "items": {"type": "string"}},
    "development": {"type": "object"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer", "number"]}},
          "timeout": {"type": "integer"},
          "stdout_contains": {"type": "string"},
          "meaning": {"type": "string"}
        }
      }
    }
  }
}
