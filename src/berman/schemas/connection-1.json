{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:connection-1",
  "title": "berman.connection/1",
  "description": "A guest study's project connection, checked when the controller commissions an assignment.",
  "type": "object",
  "required": [
    "schema",
    "id"
  ],
  "properties": {
    "schema": {
      "const": "berman.connection/1"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "argv": {
            "description": "Arguments; each is converted to text.",
            "type": "array"
          }
        }
      }
    },
    "default_recipe": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
