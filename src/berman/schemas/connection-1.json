{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:berman:schema:connection-1",
  "title": "berman.connection/1",
  "description": "A guest study's project connection, checked when the controller commissions an assignment.",
  "type": "object",
  "required": [
    "schema",
    "id"
  ],
  "properties": {
    "schema": {
      "const": "berman.connection/1"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "default_recipe": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    }
  }
}
