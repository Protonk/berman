{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "collection_id",
    "run",
    "profile",
    "entries",
    "evidence",
    "coverage",
    "streams",
    "attribution",
    "custody"
  ],
  "properties": {
    "schema": {
      "const": "berman.recording/2"
    },
    "collection_id": {
      "type": "string"
    },
    "run": {
      "type": "string",
      "pattern": "^run-[0-9]{3,6}$"
    },
    "profile": {
      "const": "split"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "file",
              "directory",
              "symlink"
            ]
          },
          "mode": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mtime_ns": {
            "type": "integer"
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "ending",
        "controller"
      ],
      "properties": {
        "ending": {
          "const": "evidence/ending.json"
        },
        "controller": {
          "const": "evidence/controller.json"
        },
        "capture": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplement": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "unknown"
      ],
      "properties": {
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "format",
          "basis"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "enum": [
              "codex-jsonl/1",
              "claude-jsonl/1",
              "unknown"
            ]
          },
          "basis": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "required": [
        "connection",
        "basis",
        "evidence"
      ],
      "properties": {
        "connection": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "custody": {
      "type": "object",
      "required": [
        "inventory"
      ],
      "properties": {
        "inventory": {
          "type": "object",
          "required": [
            "run",
            "current_root",
            "entries"
          ],
          "properties": {
            "run": {
              "type": "string"
            },
            "current_root": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "type",
                  "mode"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "file",
                      "directory",
                      "symlink"
                    ]
                  },
                  "mode": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mtime_ns": {
                    "type": "integer"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "title": "berman.recording/2",
  "$id": "urn:berman:schema:recording-2",
  "description": "Structural contract for berman.recording/2. Dependency-free runtime readers additionally check identities, references, membership and bytes."
}
